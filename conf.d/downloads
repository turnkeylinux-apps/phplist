#!/bin/bash -ex

VERSION=3.7.0
ARCHIVE=phplist-$VERSION.zip
CHECKSUM=phplist-$VERSION.sha256
BASE_URL=https://downloads.sourceforge.net/project/phplist/phplist/$VERSION
EXPECTED_SHA256=0b1c2eae6a7fd617d18438d97d47714b4cbfdf3e6b2abab8a154e17d28ec89de

proxy_args=()
if [ -n "${FAB_HTTP_PROXY:-}" ]; then
    proxy_args=(--proxy "$FAB_HTTP_PROXY")
fi

cd /usr/local/src
curl --fail --location --show-error \
    --proto '=https' --proto-redir '=https' \
    "${proxy_args[@]}" --output "$ARCHIVE" "$BASE_URL/$ARCHIVE"
curl --fail --location --show-error \
    --proto '=https' --proto-redir '=https' \
    "${proxy_args[@]}" --output "$CHECKSUM" "$BASE_URL/$CHECKSUM"

published=$(awk -v archive="$ARCHIVE" '$2 == archive { print $1 }' "$CHECKSUM")
test "$published" = "$EXPECTED_SHA256"
printf '%s  %s\n' "$EXPECTED_SHA256" "$ARCHIVE" | sha256sum --check -
